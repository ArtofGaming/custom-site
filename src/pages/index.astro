---
import { getCollection, render } from "astro:content";
import PersonalBaseLayout from '../layouts/PersonalBaseLayout.astro';
import WorksGallery from "../components/Works Gallery.astro";

const pageTitle = "Portfolio";
const allWork = await getCollection('works');
---

<PersonalBaseLayout pageTitle={pageTitle}>
	<h1>I am currently <em>available</em> for paid work.</h1>
    <br>
    I provide people making narrative-based games like RPGs, VNs, and horror games with the code they need to not only make their games work, but help them implement features that help their games shine like they deserve using C# in both Godot and Unity as well as Python for RenPy.

    <h2>Services I Provide</h2>
        <h4>Scripting</h4>
        <p>I put your script into your Godot, Unity, or RenPy game and get it playable. This includes things like directing sprite movements, choosing camera angles, and making sure branching and variables all connect correctly.</p>
        <h4>Programming</h4>
        <p>I can help with implementing combat and character logic, UI/UX implementation, providing controller support, and creating procedural generation tools for use in Unity, Godot, or RenPy.</p>

    <h2>Rates</h2>
    <h3>I charge <em>$100USD </em>  per task.</h3>
    <h3>A task is something like...</h3>
    <ul>
        <li>Implement custom UI with provided assets</li>
        <li>Help me update my game to the latest version of my engine</li>
        <li>Make a basic feature (ex. catching minigame, infinite runner, schedule system)</li>
        <li>Script a chapter of a VN or narrative game with provided script and assets</li>
    </ul>

    <h2>Notable Past Works</h2>
    <ul role="list" class="link-card-grid-b">
		{allWork.sort((a,b) => {
			return Date.parse(b.data.pubDate.toLocaleDateString()) - Date.parse(a.data.pubDate.toLocaleDateString())
		}).map((work) => <WorksGallery
			pubDate={work.data.pubDate}
			title={work.data.title}
            role={work.data.role}
			url={`../work/${work.data.title}/`}
			image={work.data.image.url}
            description={work.data.description}
            link={work.data.link}
		/>)}	
	</ul>

    <center><h3>Email theartofgaming0@proton.me for inquiries.</h3></center>
</PersonalBaseLayout>

